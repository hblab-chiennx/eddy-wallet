      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|soft|outline)$/]",
        "message": "<IconButton> tone must be one of 'plain' | 'soft' | 'outline'."
